# Copy to .env for local development. Never commit .env.
# In production every one of these is a Railway variable, not a file.

# Railway's Postgres plugin injects this automatically in production.
DATABASE_URL=postgres://teeta:localdev@localhost:5432/teeta

# Signs the session cookie. Generate with:  openssl rand -base64 48
SESSION_SECRET=change-me-to-something-long-and-random

# Applied at every boot: if both are set, the login is created or its password
# replaced before the server starts listening. DELETE ADMIN_PASSWORD from
# Railway once you have signed in — the hash is in the database by then.
# Both are trimmed, so a trailing newline from a paste cannot get hashed into
# the password. To reset without a variable: npm run set-password <email>
ADMIN_EMAIL=teeta@example.com
ADMIN_PASSWORD=change-me

# Optional. Railway sets PORT itself; this is only for local runs.
PORT=3000
